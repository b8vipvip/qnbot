# 公网域名，例如 api-console.example.com。域名需解析到 Ubuntu 服务器公网 IP。
CONTROL_PLANE_DOMAIN=api-console.example.com
PUBLIC_BASE_URL=https://api-console.example.com

# 管理员登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Cookie 与会话签名。至少 32 字节随机值。
APP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true

# 上游 ApiKey 与企业微信敏感字段的加密主密钥。必须长期固定并纳入备份。
# 生成命令：
# docker run --rm python:3.11-slim python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=replace-with-fernet-key

DATA_DIR=/data
DATABASE_PATH=/data/api-control-plane.db

# Windows Bot 更新缓存。服务端每 5 分钟刷新一次 GitHub latest Release；
# GitHub 临时故障时最多使用 24 小时内的旧缓存，安装包镜像保留最近 3 个版本。
# PREFETCH 默认开启：服务启动后立即检查当前正式版，之后每 5 分钟检查一次；
# 如果 GitHub 出现新 Release 且服务端尚未缓存安装包，会后台单飞下载并完成 SHA-256 校验。
# 客户端触发安装时也可立即触发同一 ensure 任务；若服务端正在下载，则复用正在进行的任务。
BOT_UPDATE_CACHE_DIR=/data/bot-update-cache
BOT_UPDATE_METADATA_CACHE_SECONDS=300
BOT_UPDATE_METADATA_STALE_SECONDS=86400
BOT_UPDATE_GITHUB_TIMEOUT_SECONDS=12
BOT_UPDATE_PACKAGE_TIMEOUT_SECONDS=600
BOT_UPDATE_KEEP_PACKAGE_VERSIONS=3
BOT_UPDATE_PREFETCH_ENABLED=true
BOT_UPDATE_PREFETCH_POLL_SECONDS=300

# GitHub Release/元数据网络增强：
# - 安装包使用 HTTP Range 断点续传，网络中断保留 .partial；
# - 默认最多 8 次指数退避重试；连接超时和读取超时分开控制；
# - 可选代理同时用于 GitHub API、update.json 和 Release 安装包。
BOT_UPDATE_DOWNLOAD_MAX_ATTEMPTS=8
BOT_UPDATE_DOWNLOAD_RETRY_BASE_SECONDS=2
BOT_UPDATE_DOWNLOAD_RETRY_MAX_SECONDS=60
BOT_UPDATE_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=15
BOT_UPDATE_DOWNLOAD_READ_TIMEOUT_SECONDS=300
# 默认留空即 HTTPS 直连。若代理运行在 Ubuntu 宿主机，可使用
# socks5h://host.docker.internal:1080 或 http://host.docker.internal:8080；Compose 已映射 host-gateway。
BOT_UPDATE_GITHUB_PROXY=
SERVER_UPDATE_GITHUB_SYNC_ATTEMPTS=4

# 深度测试/管理任务可使用较长超时。
REQUEST_TIMEOUT_SECONDS=300

# 实时 Bot 非流式请求：普通中转站仍保持快速故障转移。
RUNTIME_TOTAL_BUDGET_SECONDS=45
RUNTIME_ATTEMPT_TIMEOUT_SECONDS=6
RUNTIME_MAX_URLS_PER_ROUTE=1

# chat2api 通过串行的真实 ChatGPT 浏览器标签页完成请求，首包/完整 JSON 可能超过 50 秒。
# 2026-08 实机已出现首 token 51.1s、总耗时 53.0s；20 秒会导致控制面先 curl(28) 超时，
# 但浏览器任务随后仍 completed，并诱发同一桥的重复协议请求。这里给单次请求足够时间完成。
# 普通供应商仍保持上面的 6 秒单次快速失败；chat2api 超时后禁止立即对同一 provider 做协议重试。
# 90 秒总预算只在本次候选路由实际包含 chat2api 时生效；普通中转站仍保持 45 秒总预算。
CHAT2API_REALTIME_ATTEMPT_TIMEOUT_SECONDS=75
CHAT2API_REALTIME_TOTAL_BUDGET_SECONDS=90

# 重型后台结构化任务（例如批量优化知识库）使用独立预算。
# 当 max_tokens >= BACKGROUND_MIN_MAX_TOKENS 时自动进入 background 路由。
# 不要把单次超时设得过短，否则上游已经开始生成但本服务提前放弃，会造成重复请求和重复计费。
BACKGROUND_MIN_MAX_TOKENS=4000
BACKGROUND_TOTAL_BUDGET_SECONDS=240
BACKGROUND_ATTEMPT_TIMEOUT_SECONDS=90

# 可选 Embedding 语义检索网关预算。Bot 端还会使用更短的本地等待上限；超时会自动降级为本地混合检索。
EMBEDDING_TOTAL_BUDGET_SECONDS=15
EMBEDDING_ATTEMPT_TIMEOUT_SECONDS=10
EMBEDDING_MAX_INPUTS=64

# 服务端 OCR 使用 RapidOCR/ONNXRuntime，模型在镜像构建阶段预取；不配置以下变量也能直接运行。
# 这些值只作为首次启动/控制台“恢复环境默认值”时的默认值。首次启动后，以 SQLite 中
# “服务端 OCR”控制台配置为准，保存后立即影响新请求，无需重启服务。
OCR_ENABLED=true
OCR_MAX_IMAGE_BYTES=8388608
OCR_TIMEOUT_SECONDS=16
OCR_MAX_CONCURRENCY=2
OCR_MAX_TEXT_CHARS=6000
# 图片视觉理解主判断默认优先级：ocr_first 或 ai_first。
# ocr_first=先尝试 OCR+知识库V2 安全直答；ai_first=优先由视觉AI作主判断，OCR仅作辅助证据。
OCR_VISION_PRIORITY=ocr_first

# 流式请求在收到第一个真实文本片段前仍允许切换中转站/模型；开始输出后锁定该上游。
RUNTIME_STREAM_FIRST_EVENT_TIMEOUT_SECONDS=8
RUNTIME_STREAM_IDLE_TIMEOUT_SECONDS=35
SCHEDULER_POLL_SECONDS=60

# 定时深测得到“不可用：没有模型通过文本调用测试”后，按此间隔持续重试。
# 任一文本模型恢复可用，或在页面关闭该供应商的“定时深测”，重试自动停止。
SCHEDULED_DEEP_TEST_RETRY_MINUTES=10
SCHEDULED_DEEP_TEST_RETRY_POLL_SECONDS=60

# 企业微信应用消息与加密回调请登录控制面，在“企业微信”页面配置。
# CorpID、应用 Secret、AgentId、接收成员、回调 Token、EncodingAESKey
# 均使用 API_KEY_ENCRYPTION_KEY 加密保存在 SQLite，不从 .env 读取。