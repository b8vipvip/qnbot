<Project>
  <PropertyGroup>
    <!-- Legacy .NET Framework projects in this repo reference several vendor DLLs stored in src\Bin. -->
    <ReferencePath>$(MSBuildThisFileDirectory)Bin;$(ReferencePath)</ReferencePath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\OrderTemplateRequiredFieldsV2.cs')">
    <!--
      OrderTemplateRequiredFieldsV2.cs supersedes the runtime bootstraps previously supplied by
      OrderTemplateTradeDetailBridge.cs and OrderTemplateReceiveNewMessageTradeDetailBridge.cs.
      The legacy source files remain in the repository for history/regression reference, but are no
      longer compiled, preventing two enrichment pipelines from racing to send the same order reply.

      OrderTemplateRequiredFieldsPriority.cs is part of the same runtime contract. It must be
      compiled together with V2 so the required-field owner is ordered ahead of the legacy
      messageCenterNotify consumers before a sparse order snapshot can be rendered and sent.
    -->
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\OrderTemplateRequiredFieldsV2.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\OrderTemplateRequiredFieldsPriority.cs"
             Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\OrderTemplateRequiredFieldsPriority.cs')" />
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\RechargeStatusAutoQueryService.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\BotWebConsoleSyncService.cs')">
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\BotWebConsoleSyncService.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\BuyerSessionAgent.cs')">
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\BuyerSessionAgent.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\BuyerSessionAgentRuntimeBridge.cs" Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\BuyerSessionAgentRuntimeBridge.cs')" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\LocalOcrService.cs')">
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\LocalOcrService.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\OcrFirstKnowledgeDecisionService.cs" Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\OcrFirstKnowledgeDecisionService.cs')" />
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\VisionOcrPriorityService.cs" Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\VisionOcrPriorityService.cs')" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\ChromeNs\BusinessInboundLivenessRecoveryBridge.cs')">
    <Compile Include="$(MSBuildProjectDirectory)\ChromeNs\BusinessInboundLivenessRecoveryBridge.cs" />
  </ItemGroup>
</Project>