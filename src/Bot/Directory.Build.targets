<Project>
  <!--
    Transitional v10 -> v11 migration. The released Bot.exe must embed the recoverable
    WebView payload and compile QNInject with the same marker even while the source
    migration is being validated. The script is idempotent and never runs on clients;
    it only transforms the CI/build workspace before resources and C# are compiled.
  -->
  <Target Name="ApplyRecoverableQianniuInjectV11"
          BeforeTargets="PrepareResources;CoreCompile"
          Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildThisFileDirectory)..\..\scripts\apply-recoverable-inject-v11.ps1')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\apply-recoverable-inject-v11.ps1&quot;" />
  </Target>
</Project>
