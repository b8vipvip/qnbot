<Project>
  <!-- Preserve repository-wide reference paths and compile items for Bot and WPF *_wpftmp projects. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Directory.Build.props')" />

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\RulePolicyImportExportUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\RulePolicyImportExportUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\KnowledgeCloudSyncService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCloudSyncService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\StoreRuleCloudSyncService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\StoreRuleCloudSyncService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\ClientDataCloudBackupService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\ClientDataCloudBackupService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ShopScope\ShopContext.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\IShopScopedPathProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopContext.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopContextLocator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopControlPlaneConnectionStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopApiDiagnosticsService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopIdentityResolver.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopKeyGenerator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopLegacyDataMigrationService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopProfile.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopProfileStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedParamBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedPathProvider.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedRuntimeBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedSettingsStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopScopedUiBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopSettingsScope.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopTokenStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShopScope\ShopTokenBindingService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Options\ShopBindingOptionsControl.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Options\FeatureSettingsOptionsControl.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Options\FeatureSettingsOptionsControl.cs" />
  </ItemGroup>

  <!-- Virtual-goods auto-delivery is code-only UI/runtime and must also be visible to WPF
       temporary projects. Keep all four pieces together so a partial QN/App type is never omitted. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Options\AutoDeliveryOptionsControl.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Options\AutoDeliveryOptionsControl.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\VirtualGoodsAutoDelivery.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\AutoDeliveryOrderEventSeed.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AutoDeliveryAppBootstrap.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\ReplyModeService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\ReplyModeService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\KnowledgeMemoryEngine.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\KnowledgeMemoryEngine.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\KnowledgeMemoryEngineUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeMemoryEngineUi.cs" />
  </ItemGroup>

  <!-- Knowledge Center V2 is explicitly included for the normal Bot project and WPF *_wpftmp projects. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Models.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Models.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Repository.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Semantics.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Service.Index.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Service.Incremental.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2.Service.Public.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2FeedbackService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2RevisionService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2GovernanceAuditService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2GovernanceService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeEngineV2GovernanceBootstrap.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterHelpWindow.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\LegacyKnowledgePreviewWindow.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2Ui.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2RecordsPage.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2OperationsPages.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2QualityUi.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2RevisionUi.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2GovernanceUi.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2SmartImportService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeCenterV2AiToolsUi.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2NaturalLanguageService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2OperatorUiBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\KnowledgeV2LegacyDeltaImportService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\KnowledgeEngineV2RuntimeBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\KnowledgeEngineV2LearningBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\KnowledgeEngineV2FeedbackBridge.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)AssistWindow\Widget\RightPanel.SettingsEntry.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)AssistWindow\Widget\RightPanel.SettingsEntry.cs" />
  </ItemGroup>

  <!-- Attached-only Bot UI. These helpers must also be visible to WPF *_wpftmp projects. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)AssistWindow\WndAssist.MultiShopAttached.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)AssistWindow\WndAssist.MultiShopAttached.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AssistWindow\WndAssist.AttachedPerformance.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AssistWindow\Widget\Robot\CtlRobot.MultiShopSession.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)AssistWindow\Widget\Robot\CtlRobot.ControlPlaneStatus.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Automation\ChatDeskNs\DeskSellerBindingRegistry.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Automation\ChatDeskNs\DeskSellerBindingRegistry.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\MultiShopRuntimeSessionCoordinator.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\MultiShopRuntimeSessionCoordinator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\QNRpa.MultiShopDeskBinding.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\QNRpa.NativeSend.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\QNRpa.NativeSend.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\DuplicateCdpInboundRecoveryBridge.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\DuplicateCdpInboundRecoveryBridge.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\FirstInquiryStreamingGuard.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\FirstInquiryStreamingGuard.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\DeterministicAutoReplyService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\DeterministicAutoReplyService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\BotWebBotEnabledSyncService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\BotWebBotEnabledSyncService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\BotWebAutoReplyRulesSyncService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\BotWebAutoReplyRulesSyncService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\MessageProcessingTraceService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\MessageProcessingTraceService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\BusinessPolicyProfileService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\BusinessPolicyProfileService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\BusinessPolicyProfileUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\BusinessPolicyProfileUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Knowledge\BulkListManagementUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Knowledge\BulkListManagementUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\BulkListManagementUiBridge.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\BulkListManagementUiBridge.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)ChromeNs\HandoffPolicyLegacyMigrationService.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)ChromeNs\HandoffPolicyLegacyMigrationService.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Options\HandoffPolicyUi.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)Options\HandoffPolicyUi.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)default-business-policy.json')">
    <Content Include="$(MSBuildThisFileDirectory)default-business-policy.json">
      <Link>default-business-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The optimized updater replaces the legacy implementation at compile time.
       This target runs after repository-wide targets add the historical source,
       so both the normal Bot project and WPF *_wpftmp projects compile exactly
       one BotUpdateService implementation. -->
  <Target Name="UseOptimizedBotUpdateService" BeforeTargets="CoreCompile"
          Condition="Exists('$(MSBuildThisFileDirectory)Update\BotUpdateService.Core.Fast.cs')">
    <ItemGroup>
      <Compile Remove="$(MSBuildThisFileDirectory)Update\BotUpdateService.cs" />
      <Compile Include="$(MSBuildThisFileDirectory)Update\BotUpdate*.Fast.cs" />
    </ItemGroup>
  </Target>
</Project>
